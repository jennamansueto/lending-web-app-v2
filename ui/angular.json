          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "remotes/loan-application/src/main.ts",
            "tsConfig": "remotes/loan-application/tsconfig.app.json",
