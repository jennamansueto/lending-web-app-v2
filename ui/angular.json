            "production": {
              "buildTarget": "loan-application:esbuild:production"
            },
            "development": {
              "buildTarget": "loan-application:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "remotes/loan-application/**/*.ts",
              "remotes/loan-application/**/*.html"
            ],
            "eslintConfig": "remotes/loan-application/eslint.config.js"
          }
        }
      }
    },
